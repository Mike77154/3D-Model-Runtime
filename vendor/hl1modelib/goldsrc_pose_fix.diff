+static int hlfp__quat_normalize_frame_position(const hlfp_mdl_seqdesc *seq,
+                                               hlfp_fixed frame_position,
+                                               int *frame,
+                                               hlfp_fixed *frac,
+                                               hlfp_error *err) {
+    hlfp_fixed pos;
+    hlfp_fixed range;
+    hlfp_fixed max_pos;
+    if (seq == 0 || frame == 0 || frac == 0) {
+        return hlfp__set_error(err, HLFP_ERR_BAD_ARGUMENT, 0, 0, "null quaternion frame normalize input");
+    }
+    if (seq->numframes <= 0) {
+        return hlfp__set_error(err, HLFP_ERR_BAD_FORMAT, 0, 0, "sequence has no frames");
+    }
+    if (seq->numframes == 1) {
+        *frame = 0;
+        *frac = 0;
+        return HLFP_OK;
+    }
+    pos = frame_position;
+    if ((seq->flags & HLFP_STUDIO_LOOPING) != 0) {
+        range = (hlfp_fixed)((seq->numframes - 1) << HLFP_FIXED_FRAC_BITS);
+        if (range <= 0) {
+            *frame = 0;
+            *frac = 0;
+            return HLFP_OK;
+        }
+        while (pos < 0) pos += range;
+        while (pos >= range) pos -= range;
+        *frame = (int)(pos >> HLFP_FIXED_FRAC_BITS);
+        *frac = pos & 0xFFFF;
+        return HLFP_OK;
+    }
+    if (pos <= 0) {
+        *frame = 0;
+        *frac = 0;
+        return HLFP_OK;
+    }
+    max_pos = (hlfp_fixed)((seq->numframes - 1) << HLFP_FIXED_FRAC_BITS);
+    if (pos >= max_pos) {
+        *frame = seq->numframes - 1;
+        *frac = 0;
+        return HLFP_OK;
+    }
+    *frame = (int)(pos >> HLFP_FIXED_FRAC_BITS);
+    *frac = pos & 0xFFFF;
+    return HLFP_OK;
+}
